{
  "name": "nexahedron",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "homepage": "https://nexahedron.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Scarabaeus1031/NEXAHEDRON.git"
  },
  "bugs": {
    "url": "https://github.com/Scarabaeus1031/NEXAHEDRON/issues"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "postcss": "8.5.22",
    "sharp": "0.35.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --hostname 127.0.0.1",
    "dev:orion": "node scripts/run-orion-transport.mjs",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "check:production-privacy": "node --no-warnings --experimental-strip-types scripts/check-production-output-privacy.mjs dist",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "check": "npm run verify:dependency && npm run contracts:check && npm run check:architecture && npm run check:docs && npm run lint",
    "verify:dependency": "node scripts/verify-orion-dependency.mjs",
    "contracts:generate": "node scripts/generate-orion-contracts.mjs",
    "contracts:check": "node scripts/generate-orion-contracts.mjs --check",
    "proof:confirmed-material": "node --no-warnings --experimental-strip-types scripts/confirmed-material-proof.mjs",
    "proof:representation-handoff": "node --no-warnings --experimental-strip-types scripts/representation-alpha-handoff.mjs",
    "proof:representation-request": "node --no-warnings --experimental-strip-types scripts/representation-referenced-request.mjs",
    "check:docs": "node scripts/check-documentation.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:a0-human": "node scripts/verify-a0-human-bundle.mjs",
    "sync:a0-public": "node scripts/sync-a0-public-site.mjs && node scripts/build-a0-human-source-manifest.mjs",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs && node scripts/test-orion-integration.mjs",
    "test:a6-1": "node --experimental-strip-types --test tests/the-eye-a6-1.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern public/a0-human"
  },
  "dependencies": {
    "next": "16.2.11",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.46.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.113.0"
  },
  "type": "module"
}
